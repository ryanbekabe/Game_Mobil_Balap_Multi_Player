<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textColor="@color/primary"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="8dp"
                android:shadowColor="#80FF4081"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="40dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_player_profile"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/player_name_hint"
                    android:textColorHint="#666"
                    android:textColor="@color/text_white"
                    android:background="@drawable/edittext_bg"
                    android:layout_marginBottom="16dp"
                    android:text="@string/default_player_name"
                    android:inputType="textPersonName"
                    android:importantForAutofill="no"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_join_settings"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/ipInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ip_host_hint"
                    android:textColorHint="#666"
                    android:textColor="@color/text_white"
                    android:background="@drawable/edittext_bg"
                    android:layout_marginBottom="24dp"
                    android:inputType="text"
                    android:importantForAutofill="no"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bot_players_label"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/botRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <RadioButton
                        android:id="@+id/bot0"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/bot_0"
                        android:textColor="@color/text_white"
                        android:checked="true"
                        android:buttonTint="@color/primary"/>
                    <RadioButton
                        android:id="@+id/bot1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/bot_1"
                        android:textColor="@color/text_white"
                        android:buttonTint="@color/primary"/>
                    <RadioButton
                        android:id="@+id/bot2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/bot_2"
                        android:textColor="@color/text_white"
                        android:buttonTint="@color/primary"/>
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bot_speed_label"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/botSpeedRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">
                    <RadioButton
                        android:id="@+id/speedSlow"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_slow"
                        android:textColor="@color/text_white"
                        android:buttonTint="@color/accent"/>
                    <RadioButton
                        android:id="@+id/speedMedium"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_medium"
                        android:textColor="@color/text_white"
                        android:checked="true"
                        android:buttonTint="@color/accent"/>
                    <RadioButton
                        android:id="@+id/speedFast"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_fast"
                        android:textColor="@color/text_white"
                        android:buttonTint="@color/accent"/>
                </RadioGroup>

                <Button
                    android:id="@+id/hostButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/host_game_btn"
                    android:background="@drawable/btn_primary"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    app:backgroundTint="@null"/>

                <Button
                    android:id="@+id/joinButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/join_game_btn"
                    android:background="@drawable/btn_primary"
                    android:backgroundTint="@color/accent"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    app:backgroundTint="@null"/>
            </LinearLayout>
            
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_default"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/myIpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_ip_placeholder"
                android:textColor="@color/success"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/gameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.hanyajasa.gamemobilbalapmultiplayer.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
            
        <ImageButton
            android:id="@+id/hostMenuBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/text_white"
            android:background="@drawable/card_bg"
            android:backgroundTint="#80000000"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/desc_menu"
            android:visibility="gone"/>

        <Button
            android:id="@+id/playAgainBtn"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_centerInParent="true"
            android:text="@string/play_again_btn"
            android:background="@drawable/btn_primary"
            android:backgroundTint="@color/warning"
            android:textColor="#000"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:visibility="gone"/>

        <!-- In-game UI Overlays -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:padding="24dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                
                <ImageButton
                    android:id="@+id/leftBtn"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:backgroundTint="#40FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="16dp"
                    android:contentDescription="@string/desc_left"/>
                
                <ImageButton
                    android:id="@+id/rightBtn"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:backgroundTint="#40FFFFFF"
                    android:layout_marginStart="16dp"
                    android:scaleType="fitCenter"
                    android:padding="16dp"
                    android:contentDescription="@string/desc_right"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/accelBtn"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/text_white"
                android:background="@drawable/card_bg"
                android:backgroundTint="#60FF4081"
                android:scaleType="fitCenter"
                android:padding="24dp"
                android:contentDescription="@string/desc_accel"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>